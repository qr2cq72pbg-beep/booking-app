# Copy to .env.local for local development.
# Browser-only values. NEVER put SUPABASE_SERVICE_ROLE_KEY here.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY


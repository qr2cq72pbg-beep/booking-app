# Copy values into Supabase Dashboard → Project Settings → Edge Functions → Secrets
# Or: supabase secrets set --env-file supabase/secrets.env

RESEND_API_KEY=re_your_key_here
BOOKING_EMAIL_FROM=Bookings <noreply@yourdomain.com>
APP_PUBLIC_BASE_URL=https://yourdomain.com/index.html

# Push notifications (send-customer-notification + send-business-event-notification)
FCM_SERVER_KEY=your_fcm_legacy_server_key
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apple_team_id
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_BUNDLE_ID=com.gtwebstudio.booking
APNS_PRODUCTION=false

# Optional dedicated webhook secret for send-business-event-notification.
# If unset, the Database Webhook must send Authorization: Bearer <service_role>.
# BUSINESS_PUSH_DISPATCH_SECRET=replace_with_a_long_random_secret

# Customer invite 9-digit app login (HMAC at rest). Generate a long random value
# in the Dashboard; do not commit the real secret.
# CUSTOMER_APP_LOGIN_HMAC_SECRET=

# Usually auto-injected by Supabase (do not commit real service role key):
# SUPABASE_URL=https://sdqothuulzeczcncyfqd.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
